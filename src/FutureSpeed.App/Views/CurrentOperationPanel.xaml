<UserControl x:Class="FutureSpeed.App.Views.CurrentOperationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FutureSpeed.App.Localization"
             xmlns:vm="clr-namespace:FutureSpeed.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Border Style="{StaticResource Card}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <TextBlock Text="{loc:Str Progress_Title}" Style="{StaticResource Text.H2}" />

                <!-- ============ no active job ============ -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding HasActiveJob, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                    <Border Style="{StaticResource CardAlt}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Str Progress_None}"
                                       Style="{StaticResource Text.Muted}"
                                       TextAlignment="Center"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Btn.Primary}"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding GoCommand}"
                            CommandParameter="NewTransfer"
                            Content="{loc:Str Nav_NewTransfer}" />
                </StackPanel>

                <!-- ============ active job ============ -->
                <!-- Visibility lives on the outer panel: the inner one re-points DataContext
                     to the job, and a binding on the same element would be evaluated against
                     that new (possibly null) context. -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding HasActiveJob, Converter={StaticResource HasValue}}">
                <StackPanel DataContext="{Binding ActiveJob}">

                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="{Binding State, Converter={StaticResource EnumLabel}, ConverterParameter=State_}"
                                       FontSize="11" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                Background="{DynamicResource Brush.SurfaceAlt}">
                            <TextBlock Text="{Binding Mode, Converter={StaticResource EnumLabel}, ConverterParameter=Transfer_Mode_}"
                                       FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                Visibility="{Binding IsVerifying, Converter={StaticResource HasValue}}">
                            <TextBlock Text="{loc:Str Progress_Verifying}" FontSize="11" />
                        </Border>
                    </StackPanel>

                    <!-- progress -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Muted}"
                                   Text="{Binding CurrentFileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.H3}"
                                   Text="{Binding Percent, Converter={StaticResource Percent}}" />
                    </Grid>

                    <ProgressBar Style="{StaticResource Bar.Main}"
                                 Margin="0,6,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource Text.Mono}"
                               Margin="0,6,0,0"
                               Text="{Binding CurrentFilePath}"
                               ToolTip="{Binding CurrentFilePath}" />

                    <Border Style="{StaticResource Separator.H}" />

                    <!-- metrics -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="{loc:Str Progress_Speed}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding CurrentSpeed, Converter={StaticResource Speed}}" Style="{StaticResource Text.Metric}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Str Progress_AverageSpeed}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding AverageSpeed, Converter={StaticResource Speed}}" Style="{StaticResource Text.Metric}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="{loc:Str Progress_Elapsed}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding Elapsed, Converter={StaticResource Duration}}" Style="{StaticResource Text.H3}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Str Progress_Eta}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding Eta, Converter={StaticResource Duration}}" Style="{StaticResource Text.H3}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="{loc:Str Progress_TotalSize}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource Size}}" Style="{StaticResource Text.H3}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Str Progress_Transferred}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding TransferredBytes, Converter={StaticResource Size}}" Style="{StaticResource Text.H3}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="{loc:Str Progress_Remaining}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding RemainingBytes, Converter={StaticResource Size}}" Style="{StaticResource Text.H3}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Str Progress_FilesDone}" Style="{StaticResource Text.Muted}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CompletedFiles}" Style="{StaticResource Text.H3}" />
                                <TextBlock Text=" / " Style="{StaticResource Text.H3}" />
                                <TextBlock Text="{Binding TotalFiles}" Style="{StaticResource Text.H3}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{loc:Str Progress_Skipped}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding SkippedFiles}" Style="{StaticResource Text.H3}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <TextBlock Text="{loc:Str Progress_Failed}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding FailedFiles}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.H3}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Separator.H}" />

                    <TextBlock Text="{loc:Str Common_Destination}" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding Destination}" Style="{StaticResource Text.Mono}" ToolTip="{Binding Destination}" />
                </StackPanel>
                </StackPanel>

                <!-- ============ controls ============ -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding HasActiveJob, Converter={StaticResource HasValue}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Margin="0,0,5,0"
                                Style="{StaticResource Btn.Secondary}"
                                Command="{Binding PauseActiveCommand}"
                                Content="{loc:Str Common_Pause}"
                                Visibility="{Binding ActiveJob.IsPaused, Converter={StaticResource HasValue}, ConverterParameter=invert}" />

                        <Button Grid.Column="0" Margin="0,0,5,0"
                                Style="{StaticResource Btn.Primary}"
                                Command="{Binding ResumeActiveCommand}"
                                Content="{loc:Str Common_Resume}"
                                Visibility="{Binding ActiveJob.IsPaused, Converter={StaticResource HasValue}}" />

                        <Button Grid.Column="1" Margin="5,0,0,0"
                                Style="{StaticResource Btn.Danger}"
                                Command="{Binding CancelActiveCommand}"
                                Content="{loc:Str Common_Cancel}" />
                    </Grid>

                    <Button Style="{StaticResource Btn.Secondary}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenActiveDestinationCommand}"
                            Content="{loc:Str Common_OpenFolder}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
