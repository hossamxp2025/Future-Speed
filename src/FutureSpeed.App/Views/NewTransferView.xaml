<UserControl x:Class="FutureSpeed.App.Views.NewTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FutureSpeed.App.Localization"
             xmlns:vm="clr-namespace:FutureSpeed.App.ViewModels"
             xmlns:core="clr-namespace:FutureSpeed.Core.Models;assembly=FutureSpeed.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NewTransferViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{loc:Str Transfer_Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,14" />

            <!-- ================= sources ================= -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Str Transfer_Sources}" Style="{StaticResource Text.H2}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,6,0"
                                    AutomationProperties.AutomationId="AddFilesButton"
                                    Command="{Binding AddFilesCommand}" Content="{loc:Str Common_AddFiles}" />
                            <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,6,0"
                                    AutomationProperties.AutomationId="AddFolderButton"
                                    Command="{Binding AddFolderCommand}" Content="{loc:Str Common_AddFolder}" />
                            <Button Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding ClearSourcesCommand}" Content="{loc:Str Common_Clear}" />
                        </StackPanel>
                    </Grid>

                    <!-- drop zone -->
                    <Border Margin="0,12,0,0"
                            MinHeight="92"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            AllowDrop="True"
                            Drop="OnDrop"
                            DragOver="OnDragOver"
                            Visibility="{Binding HasSources, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Str Transfer_DropHint}" Style="{StaticResource Text.Muted}"
                                       TextAlignment="Center" Margin="12,8,12,0" />
                        </StackPanel>
                    </Border>

                    <!-- source list -->
                    <Border Margin="0,12,0,0"
                            AllowDrop="True"
                            Drop="OnDrop"
                            DragOver="OnDragOver"
                            Visibility="{Binding HasSources, Converter={StaticResource HasValue}}">
                        <ListBox Style="{StaticResource List.Plain}"
                                 ItemContainerStyle="{StaticResource ListItem.Plain}"
                                 MaxHeight="190"
                                 ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding}" />
                                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}"
                                                Content="&#xE711;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= destination + mode ================= -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str Transfer_Destination}" Style="{StaticResource Text.H2}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource Btn.Secondary}"
                                Command="{Binding BrowseDestinationCommand}"
                                Content="{loc:Str Common_Browse}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentDestinations}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Ghost}"
                                        Content="{Binding}"
                                        FontSize="11"
                                        Margin="0,0,6,4"
                                        ToolTip="{Binding}"
                                        Command="{Binding DataContext.SetDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Separator.H}" />

                    <TextBlock Text="{loc:Str Transfer_Mode}" Style="{StaticResource Text.H3}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="{loc:Str Transfer_Mode_Copy}" GroupName="Mode" Margin="0,0,18,0"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Copy}" />
                        <RadioButton Content="{loc:Str Transfer_Mode_Move}" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Move}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Str Transfer_MoveWarning}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="Move">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <CheckBox Content="{loc:Str Transfer_Verify}" IsChecked="{Binding VerifyWithSha256}" Margin="0,10,0,0" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str Transfer_JobName}" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Muted}" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <CheckBox Content="{loc:Str Transfer_ScheduleEnable}" IsChecked="{Binding IsScheduled}" Margin="0,10,0,0" />
                    <DatePicker SelectedDate="{Binding ScheduledFor}"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Width="200"
                                IsEnabled="{Binding IsScheduled}" />
                </StackPanel>
            </Border>

            <!-- ================= space check ================= -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Str Space_Title}" Style="{StaticResource Text.H2}" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource Btn.Secondary}"
                                Command="{Binding AnalyzeCommand}"
                                Content="{loc:Str Transfer_Analyze}" />
                    </Grid>

                    <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Text.H3}" Margin="0,12,0,0"
                               Visibility="{Binding ScanSummary, Converter={StaticResource HasValue}}" />

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource HasValue}}" />

                    <Grid Margin="0,12,0,0" Visibility="{Binding SpaceResult, Converter={StaticResource HasValue}}"
                          DataContext="{Binding SpaceResult}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Str Space_Required}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding RequiredBytes, Converter={StaticResource Size}}" Style="{StaticResource Text.H3}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Str Space_Available}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding AvailableBytes, Converter={StaticResource Size}}" Style="{StaticResource Text.H3}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Str Space_Missing}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding MissingBytes, Converter={StaticResource Size}}"
                                       Style="{StaticResource Text.H3}"
                                       Foreground="{DynamicResource Brush.Danger}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= actions ================= -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,8" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                        Command="{Binding AddToQueueCommand}"
                        Content="{loc:Str Transfer_AddToQueue}" />
                <Button Style="{StaticResource Btn.Primary}"
                        MinWidth="160"
                        Command="{Binding StartTransferCommand}"
                        Content="{loc:Str Transfer_StartNow}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
