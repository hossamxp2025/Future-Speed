<Window x:Class="FutureSpeed.App.Views.Dialogs.SpaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FutureSpeed.App.Localization"
        Title="{loc:Str Space_Title}"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg}">

    <StackPanel Margin="22">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                       Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.H1}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />

        <Border Style="{StaticResource CardAlt}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Str Space_Required}" Style="{StaticResource Text.Muted}" />
                    <TextBlock x:Name="RequiredText" Style="{StaticResource Text.Metric}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Str Space_Available}" Style="{StaticResource Text.Muted}" />
                    <TextBlock x:Name="AvailableText" Style="{StaticResource Text.Metric}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Str Space_Missing}" Style="{StaticResource Text.Muted}" />
                    <TextBlock x:Name="MissingText" Style="{StaticResource Text.Metric}"
                               Foreground="{DynamicResource Brush.Danger}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="0,14,0,0">
            <TextBlock Text="{loc:Str Space_Volume}" Style="{StaticResource Text.Muted}" />
            <TextBlock x:Name="VolumeText" Style="{StaticResource Text.Mono}" />
            <TextBlock x:Name="ReclaimableText" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ProceedButton" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                    Content="{loc:Str Space_ProceedAnyway}" Click="OnProceed" Visibility="Collapsed" />
            <Button Style="{StaticResource Btn.Primary}" MinWidth="120"
                    Content="{loc:Str Common_Close}" Click="OnClose" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
