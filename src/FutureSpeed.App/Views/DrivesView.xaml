<UserControl x:Class="FutureSpeed.App.Views.DrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FutureSpeed.App.Localization"
             xmlns:vm="clr-namespace:FutureSpeed.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DrivesViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{loc:Str Drives_Title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{loc:Str Drives_Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource Btn.Secondary}"
                    Command="{Binding RefreshCommand}"
                    Content="{loc:Str Common_Refresh}" />
        </Grid>

        <!-- hot-plug notice -->
        <Border Grid.Row="1"
                Style="{StaticResource CardAlt}"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding DeviceNotice, Converter={StaticResource HasValue}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{Binding DeviceNotice}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- drive cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriveCardViewModel}">
                        <Border Style="{StaticResource Card}" Width="300" Margin="0,0,14,14">
                            <StackPanel>
                                <!-- title row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                            Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock Text="{Binding Letter}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.H3}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           Text="{Binding Kind, Converter={StaticResource EnumLabel}, ConverterParameter=Drives_Kind_}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="6,0,0,0"
                                                       Text="{Binding FileSystem}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- not ready -->
                                <TextBlock Text="{loc:Str Drives_NotReady}"
                                           Style="{StaticResource Text.Muted}"
                                           Margin="0,12,0,0"
                                           Visibility="{Binding IsReady, Converter={StaticResource HasValue}, ConverterParameter=invert}" />

                                <!-- usage -->
                                <StackPanel Visibility="{Binding IsReady, Converter={StaticResource HasValue}}">
                                    <ProgressBar Style="{StaticResource Bar.Thin}"
                                                 Margin="0,14,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding UsedPercent, Mode=OneWay}" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Str Drives_Capacity}" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource Size}}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Str Drives_Used}" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Text="{Binding UsedBytes, Converter={StaticResource Size}}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Str Drives_Free}" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Text="{Binding FreeBytes, Converter={StaticResource Size}}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <!-- The destination button takes the remaining width: its label is the
                                             longer one and must never be clipped in either language. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,5,0"
                                                Style="{StaticResource Btn.Primary}"
                                                Content="{loc:Str Drives_SetAsDestination}"
                                                Command="{Binding DataContext.UseAsDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <Button Grid.Column="1" Margin="5,0,0,0"
                                                Style="{StaticResource Btn.Secondary}"
                                                Content="{loc:Str Common_Source}"
                                                Command="{Binding DataContext.UseAsSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
