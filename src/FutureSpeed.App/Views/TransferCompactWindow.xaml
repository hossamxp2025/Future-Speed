<Window x:Class="FutureSpeed.App.Views.TransferCompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FutureSpeed.App.Localization"
        xmlns:vm="clr-namespace:FutureSpeed.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CompactTransferViewModel}"
        Title="{loc:Str Compact_Title}"
        Width="760" Height="760"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        TextOptions.TextFormattingMode="Ideal"
        ShowInTaskbar="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource Brush.AccentGradient}">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{StaticResource Badge}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Accent}"
                                       Text="{Binding Mode, Converter={StaticResource EnumLabel}, ConverterParameter=Transfer_Mode_}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{DynamicResource Brush.SurfaceAlt}">
                            <TextBlock FontSize="11"
                                       Text="{Binding State, Converter={StaticResource EnumLabel}, ConverterParameter=State_}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{DynamicResource Brush.SurfaceAlt}"
                                Visibility="{Binding IsVerifying, Converter={StaticResource HasValue}}">
                            <TextBlock FontSize="11" Text="{loc:Str Compact_Verifying}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}"
                            Command="{Binding MinimizeToTrayCommand}"
                            ToolTip="{loc:Str Compact_Minimize}">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}"
                            Command="{Binding OpenMainWindowCommand}"
                            ToolTip="{loc:Str Compact_OpenMain}">
                        <TextBlock Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== current file ===================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Str Compact_CurrentFile}" Style="{StaticResource Text.Muted}" />
                <TextBlock Text="{Binding CurrentFileName}" Style="{StaticResource Text.H3}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Str Compact_From}" Style="{StaticResource Text.Muted}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentSource}" Style="{StaticResource Text.Mono}"
                               ToolTip="{Binding CurrentSource}" />
                </Grid>
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Str Compact_To}" Style="{StaticResource Text.Muted}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentDestination}" Style="{StaticResource Text.Mono}"
                               ToolTip="{Binding CurrentDestination}" />
                </Grid>

                <TextBlock Text="{loc:Str Compact_FileProgress}" Style="{StaticResource Text.Muted}" Margin="0,10,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Style="{StaticResource Bar.Thin}" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"
                                 Value="{Binding FilePercent, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right"
                               FontWeight="SemiBold"
                               Text="{Binding FilePercent, Converter={StaticResource Percent}}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== overall ===================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{loc:Str Compact_TotalProgress}" Style="{StaticResource Text.Muted}" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.H3}"
                               Text="{Binding TotalPercent, Converter={StaticResource Percent}}" />
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Style="{StaticResource Bar.Main}" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"
                                 Value="{Binding TotalPercent, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" MinWidth="44" TextAlignment="Right"
                               FontWeight="SemiBold"
                               Text="{Binding TotalPercent, Converter={StaticResource Percent}}" />
                </Grid>

                <UniformGrid Columns="4" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="{loc:Str Progress_Speed}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding CurrentSpeed, Converter={StaticResource Speed}}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="{loc:Str Progress_AverageSpeed}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding AverageSpeed, Converter={StaticResource Speed}}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="{loc:Str Progress_Elapsed}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Elapsed, Converter={StaticResource Duration}}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:Str Progress_Eta}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Eta, Converter={StaticResource Duration}}" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{loc:Str Progress_Transferred}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding TransferredBytes, Converter={StaticResource Size}}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{loc:Str Progress_TotalSize}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding TotalBytes, Converter={StaticResource Size}}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{loc:Str Progress_Remaining}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding RemainingBytes, Converter={StaticResource Size}}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{loc:Str Progress_FilesDone}" Style="{StaticResource Text.Muted}" />
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding CompletedFiles, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalFiles, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </UniformGrid>

                <Border Style="{StaticResource Separator.H}" />

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Muted}">
                            <Run Text="{loc:Str Progress_Skipped}" /><Run Text=": " /><Run Text="{Binding SkippedFiles, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="14,0,0,0" Foreground="{DynamicResource Brush.Danger}">
                            <Run Text="{loc:Str Progress_Failed}" /><Run Text=": " /><Run Text="{Binding FailedFiles, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="14,0,0,0" Style="{StaticResource Text.Muted}">
                            <Run Text="{loc:Str Compact_SpaceFree}" /><Run Text=": " />
                            <Run Text="{Binding DestinationFreeBytes, Converter={StaticResource Size}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="14,0,0,0" Style="{StaticResource Text.Muted}">
                            <Run Text="{loc:Str Compact_SpaceRequired}" /><Run Text=": " />
                            <Run Text="{Binding TotalBytes, Converter={StaticResource Size}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                <Setter Property="Text" Value="{loc:Str Compact_VerifyOff}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerificationEnabled}" Value="True">
                                        <Setter Property="Text" Value="{loc:Str Compact_VerifyOn}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== file list ===================== -->
        <!-- MinHeight keeps the list readable: without it the fixed cards above squeeze
             this row to nothing on a short window. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="8" MinHeight="150">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Str Compact_FilesList}"
                           Style="{StaticResource Text.Muted}" Margin="6,2,6,6" />

                <DataGrid ItemsSource="{Binding Files}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource Brush.SurfaceAlt}"
                          Foreground="{DynamicResource Brush.Text}"
                          FontSize="12"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Str Common_Name}" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="{loc:Str Common_Source}" Binding="{Binding Source}" Width="3*" />
                        <DataGridTextColumn Header="{loc:Str Common_Destination}" Binding="{Binding Destination}" Width="3*" />
                        <DataGridTextColumn Header="{loc:Str Common_Size}"
                                            Binding="{Binding Size, Converter={StaticResource Size}}" Width="Auto" />
                        <DataGridTextColumn Header="{loc:Str Common_Status}"
                                            Binding="{Binding Outcome, Converter={StaticResource EnumLabel}, ConverterParameter=Outcome_}"
                                            Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ===================== actions ===================== -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding StatusMessage, Converter={StaticResource HasValue}}" />

            <WrapPanel HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Margin="6,0,0,0"
                        Content="{loc:Str Common_Pause}"
                        IsEnabled="{Binding CanPause}"
                        Command="{Binding PauseCommand}" />
                <Button Style="{StaticResource Btn.Secondary}" Margin="6,0,0,0"
                        Content="{loc:Str Common_Resume}"
                        IsEnabled="{Binding CanResume}"
                        Command="{Binding ResumeCommand}" />
                <Button Style="{StaticResource Btn.Secondary}" Margin="6,0,0,0"
                        Content="{loc:Str Compact_SkipFile}"
                        IsEnabled="{Binding CanSkip}"
                        Command="{Binding SkipCurrentFileCommand}" />
                <Button Style="{StaticResource Btn.Secondary}" Margin="6,0,0,0"
                        Content="{loc:Str Queue_RetryFailed}"
                        IsEnabled="{Binding HasFailures}"
                        Command="{Binding RetryFailedCommand}" />
                <Button Style="{StaticResource Btn.Secondary}" Margin="6,0,0,0"
                        Content="{loc:Str Common_OpenFolder}"
                        Command="{Binding OpenDestinationCommand}" />
                <Button Style="{StaticResource Btn.Danger}" Margin="6,0,0,0" MinWidth="110"
                        Content="{loc:Str Common_Cancel}"
                        IsEnabled="{Binding CanCancel}"
                        Command="{Binding CancelCommand}" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
