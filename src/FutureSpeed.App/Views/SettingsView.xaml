<UserControl x:Class="FutureSpeed.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FutureSpeed.App.Localization"
             xmlns:vm="clr-namespace:FutureSpeed.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{loc:Str Settings_Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,14" />

            <!-- general -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Str Settings_General}" Style="{StaticResource Text.H2}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Settings_Language}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton GroupName="Lang" Content="{loc:Str Settings_Language_Arabic}" Margin="0,0,16,0"
                                         IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=ar}" />
                            <RadioButton GroupName="Lang" Content="{loc:Str Settings_Language_English}"
                                         IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=en}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Settings_Theme}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton GroupName="Theme" Content="{loc:Str Settings_Theme_Light}" Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                            <RadioButton GroupName="Theme" Content="{loc:Str Settings_Theme_Dark}" Margin="0,0,16,0"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                            <RadioButton GroupName="Theme" Content="{loc:Str Settings_Theme_System}"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Settings_UiScale}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Slider Width="240" Minimum="0.8" Maximum="1.6" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" Value="{Binding UiScale}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding UiScale, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- performance -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str Settings_Performance}" Style="{StaticResource Text.H2}" />

                    <CheckBox Content="{loc:Str Settings_AutoTune}" IsChecked="{Binding AutoTune}" Margin="0,12,0,0" />

                    <Grid Margin="0,10,0,0" IsEnabled="{Binding AutoTune, Converter={StaticResource Not}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Settings_Buffer}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider Width="240" Minimum="4" Maximum="16384" TickFrequency="4"
                                    IsSnapToTickEnabled="True" Value="{Binding BufferSizeKb}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BufferSizeKb, StringFormat={}{0} KB}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Settings_Parallel}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Slider Width="240" Minimum="1" Maximum="32" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding MaxParallelFiles}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding MaxParallelFiles}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Settings_ConcurrentJobs}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider Width="240" Minimum="1" Maximum="8" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding MaxConcurrentJobs}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding MaxConcurrentJobs}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str Settings_SpeedLimit}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="120" Text="{Binding MaxSpeedMbPerSecond, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="MB/s" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- safety -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str Settings_Safety}" Style="{StaticResource Text.H2}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str Settings_ConflictPolicy}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <ComboBox Grid.Column="1" Width="320" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ConflictPolicies}"
                                  SelectedItem="{Binding ConflictPolicy}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}, ConverterParameter=Policy_}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <CheckBox Content="{loc:Str Settings_Verify}" IsChecked="{Binding VerifyWithSha256}" Margin="0,12,0,0" />
                    <CheckBox Content="{loc:Str Settings_PreserveTimestamps}" IsChecked="{Binding PreserveTimestamps}" />
                    <CheckBox Content="{loc:Str Settings_PreserveAttributes}" IsChecked="{Binding PreserveAttributes}" />
                    <CheckBox Content="{loc:Str Settings_EnableResume}" IsChecked="{Binding EnableResume}" />
                </StackPanel>
            </Border>

            <!-- notifications -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str Settings_Notifications}" Style="{StaticResource Text.H2}" />
                    <CheckBox Content="{loc:Str Settings_Sound}" IsChecked="{Binding PlaySoundWhenFinished}" Margin="0,12,0,0" />
                    <CheckBox Content="{loc:Str Settings_Notification}" IsChecked="{Binding ShowWindowsNotification}" />
                    <CheckBox Content="{loc:Str Settings_OpenDestination}" IsChecked="{Binding OpenDestinationWhenFinished}" />
                    <CheckBox Content="{loc:Str Settings_AutoReport}" IsChecked="{Binding SaveReportAutomatically}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str Settings_ReportFormat}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ReportFormats}"
                                  SelectedItem="{Binding DefaultReportFormat}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- paths -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str Settings_Paths}" Style="{StaticResource Text.H2}" />

                    <TextBlock Text="{loc:Str Settings_LogsDirectory}" Style="{StaticResource Text.Muted}" Margin="0,12,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LogsDirectory}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Btn.Secondary}"
                                Command="{Binding BrowseLogsCommand}" Content="{loc:Str Common_Browse}" />
                    </Grid>

                    <TextBlock Text="{loc:Str Settings_ReportsDirectory}" Style="{StaticResource Text.Muted}" Margin="0,12,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ReportsDirectory}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Btn.Secondary}"
                                Command="{Binding BrowseReportsCommand}" Content="{loc:Str Common_Browse}" />
                    </Grid>

                    <TextBlock Text="{loc:Str Settings_BackupRoot}" Style="{StaticResource Text.Muted}" Margin="0,12,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding BackupRoot}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Btn.Secondary}"
                                Command="{Binding BrowseBackupRootCommand}" Content="{loc:Str Common_Browse}" />
                    </Grid>

                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding OpenLogsCommand}" Content="{loc:Str Settings_LogsDirectory}" />
                </StackPanel>
            </Border>

            <!-- windows integration -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str Settings_Integration}" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{loc:Str Integration_Explain}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str Integration_Status}"
                                   VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding IntegrationStatusText}" FontSize="12"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <RadioButton GroupName="IntegrationScope"
                                     Content="{loc:Str Integration_ScopeUser}"
                                     IsChecked="{Binding IntegrationForAllUsers, Converter={StaticResource Not}}" />
                        <RadioButton GroupName="IntegrationScope"
                                     Content="{loc:Str Integration_ScopeMachine}"
                                     IsChecked="{Binding IntegrationForAllUsers}" />
                    </StackPanel>

                    <CheckBox Content="{loc:Str Integration_OpenCompact}" IsChecked="{Binding PreferCompactWindow}" Margin="0,12,0,0" />
                    <CheckBox Content="{loc:Str Integration_NotifyAfter}" IsChecked="{Binding ShowWindowsNotification}" />

                    <Expander Header="{loc:Str Integration_Keys}" Margin="0,10,0,0"
                              Foreground="{DynamicResource Brush.Text}">
                        <TextBlock Text="{Binding IntegrationKeysPreview}" Style="{StaticResource Text.Mono}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </Expander>

                    <TextBlock Text="{Binding IntegrationLimitNote}" Style="{StaticResource Text.Muted}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Btn.Primary}" Margin="0,0,8,0" MinWidth="150"
                                AutomationProperties.AutomationId="EnableIntegrationButton"
                                Content="{loc:Str Integration_Install}"
                                Command="{Binding EnableIntegrationCommand}" />
                        <Button Style="{StaticResource Btn.Secondary}"
                                AutomationProperties.AutomationId="DisableIntegrationButton"
                                Content="{loc:Str Integration_Remove}"
                                Command="{Binding DisableIntegrationCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- demo data -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str Settings_DemoData}" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{loc:Str Settings_DemoDataHint}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                    <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                            Command="{Binding CreateDemoDataCommand}" Content="{loc:Str Settings_DemoData}" />
                </StackPanel>
            </Border>

            <!-- actions -->
            <Grid Margin="0,16,0,16">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Success}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                            Command="{Binding ResetCommand}" Content="{loc:Str Common_Clear}" />
                    <Button Style="{StaticResource Btn.Primary}" MinWidth="140"
                            Command="{Binding SaveCommand}" Content="{loc:Str Common_Save}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
