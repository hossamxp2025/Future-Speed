<Window x:Class="FutureSpeed.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FutureSpeed.App.Localization"
        xmlns:vm="clr-namespace:FutureSpeed.App.ViewModels"
        xmlns:views="clr-namespace:FutureSpeed.App.Views"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Future Speed File Transfer"
        Height="780" Width="1280"
        MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        TextOptions.TextFormattingMode="Ideal"
        FlowDirection="{Binding FlowDirection}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <Window.Resources>
        <!-- Page view model -> view. Keeps navigation declarative and type safe. -->
        <DataTemplate DataType="{x:Type vm:DrivesViewModel}">
            <views:DrivesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewTransferViewModel}">
            <views:NewTransferView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}">
            <views:QueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ top bar ============================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.TopBar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,10,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,10">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Brush.AccentGradient}">
                        <TextBlock Text="&#xE945;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str App_Name}" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{loc:Str App_Tagline}" Style="{StaticResource Text.Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- navigation -->
                <ItemsControl Grid.Column="1" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xEDA2;"
                                 Content="{loc:Str Nav_Dashboard}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="Drives"
                                 AutomationProperties.AutomationId="NavDrives"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Drives}" />
                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xE8C8;"
                                 Content="{loc:Str Nav_NewTransfer}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="NewTransfer"
                                 AutomationProperties.AutomationId="NavNewTransfer"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=NewTransfer}" />
                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xE74E;"
                                 Content="{loc:Str Nav_Backup}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="Backup"
                                 AutomationProperties.AutomationId="NavBackup"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Backup}" />
                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xE895;"
                                 Content="{loc:Str Nav_Sync}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="Sync"
                                 AutomationProperties.AutomationId="NavSync"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Sync}" />
                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xE8FD;"
                                 Content="{loc:Str Nav_Queue}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="Queue"
                                 AutomationProperties.AutomationId="NavQueue"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Queue}" />
                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xE81C;"
                                 Content="{loc:Str Nav_History}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="History"
                                 AutomationProperties.AutomationId="NavHistory"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=History}" />
                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xE713;"
                                 Content="{loc:Str Nav_Settings}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="Settings"
                                 AutomationProperties.AutomationId="NavSettings"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                    <RadioButton Style="{StaticResource Btn.Top}" Tag="&#xE897;"
                                 Content="{loc:Str Nav_Help}"
                                 GroupName="Nav"
                                 Command="{Binding GoCommand}" CommandParameter="Help"
                                 AutomationProperties.AutomationId="NavHelp"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Help}" />
                </ItemsControl>

                <!-- quick toggles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,10">
                    <Button Style="{StaticResource Btn.Ghost}"
                            AutomationProperties.AutomationId="LanguageToggle"
                            AutomationProperties.Name="Language"
                            Command="{Binding ToggleLanguageCommand}"
                            Content="AR / EN"
                            ToolTip="{loc:Str Settings_Language}" />
                    <Button Style="{StaticResource Btn.Ghost}"
                            AutomationProperties.AutomationId="ThemeToggle"
                            AutomationProperties.Name="Theme"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{loc:Str Settings_Theme}">
                        <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ body ============================ -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- side panel: current operation -->
            <views:CurrentOperationPanel Grid.Column="0" Margin="0,0,18,0" />

            <!-- page host -->
            <ContentControl Grid.Column="1">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{Binding Drives}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="NewTransfer">
                                <Setter Property="Content" Value="{Binding NewTransfer}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Backup">
                                <Setter Property="Content" Value="{Binding Backup}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Sync">
                                <Setter Property="Content" Value="{Binding Sync}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Queue">
                                <Setter Property="Content" Value="{Binding Queue}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="History">
                                <Setter Property="Content" Value="{Binding History}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                <Setter Property="Content" Value="{Binding Settings}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Help">
                                <Setter Property="Content" Value="{Binding Help}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- ============================ status bar ============================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.TopBar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Str Drives_Title}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text=": " />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding TotalDrives}" />
                    <Border Width="1" Height="12" Background="{DynamicResource Brush.Border}" Margin="12,0" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:Str Queue_Title}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text=": " />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding ActiveJobCount}" />
                </StackPanel>

                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource Text.Muted}"
                           Text="{loc:Str App_FullName}" />
            </Grid>
        </Border>
    </Grid>
</Window>
