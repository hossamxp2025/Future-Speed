<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette: the same hues on deep slate, tuned for contrast on long transfers. -->
    <Color x:Key="Color.Bg">#0F141B</Color>
    <Color x:Key="Color.Surface">#182230</Color>
    <Color x:Key="Color.SurfaceAlt">#1F2B3A</Color>
    <Color x:Key="Color.SurfaceHover">#263548</Color>
    <Color x:Key="Color.Border">#2C3A4D</Color>
    <Color x:Key="Color.Text">#E8EEF6</Color>
    <Color x:Key="Color.TextMuted">#9AAABF</Color>
    <Color x:Key="Color.TextOnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Accent">#3B8EF0</Color>
    <Color x:Key="Color.AccentHover">#5AA2F5</Color>
    <Color x:Key="Color.AccentSoft">#1B2E46</Color>
    <Color x:Key="Color.Secondary">#2BC0A8</Color>
    <Color x:Key="Color.Success">#36B870</Color>
    <Color x:Key="Color.Warning">#E0A32E</Color>
    <Color x:Key="Color.Danger">#E06055</Color>
    <Color x:Key="Color.SideBar">#141D28</Color>
    <Color x:Key="Color.TopBar">#141D28</Color>
    <Color x:Key="Color.BarTrack">#243345</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.SideBar" Color="{StaticResource Color.SideBar}" />
    <SolidColorBrush x:Key="Brush.TopBar" Color="{StaticResource Color.TopBar}" />
    <SolidColorBrush x:Key="Brush.BarTrack" Color="{StaticResource Color.BarTrack}" />

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Secondary}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
