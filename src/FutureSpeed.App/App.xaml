<Application x:Class="FutureSpeed.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FutureSpeed.App.Converters"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the palette and is replaced at runtime by ThemeService. -->
                <ResourceDictionary Source="Themes/Palette.Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:ByteSizeConverter x:Key="Size" />
            <conv:SpeedConverter x:Key="Speed" />
            <conv:DurationConverter x:Key="Duration" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:EnumLabelConverter x:Key="EnumLabel" />
            <conv:InverseBooleanConverter x:Key="Not" />
            <conv:HasValueToVisibilityConverter x:Key="HasValue" />
            <conv:MultiplyConverter x:Key="Multiply" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
